{
    "name": "rollerworks/version",
    "description": "Semantic versioning helper library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastiaan Stok",
            "email": "s.stok@rollerscapes.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/polyfill-php85": "^1.43",
        "symfony/polyfill-php86": "^1.34",
        "composer/semver": "^3.5.2"
    },
     "require-dev": {
         "phpunit/phpunit": "^12.5 || ^13.4",
         "rollerscapes/standards": "^0.3"
     },
    "autoload": {
        "psr-4": {
            "Rollerworks\\Component\\Version\\": "src/"
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Rollerworks\\Component\\Version\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
